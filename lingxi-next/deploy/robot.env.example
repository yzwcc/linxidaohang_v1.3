# Copied to /etc/lingxi-next/robot.env (mode 0600). Never put real credentials here.
LINGXI_ENV=production
LINGXI_PORT=3000
LINGXI_HOST=0.0.0.0
LINGXI_DATA_DIR=/var/lib/lingxi-next
LINGXI_WEB_ROOT=/opt/lingxi-next/current/web
LINGXI_TLS_KEY=/etc/lingxi-next/tls/robot.key
LINGXI_TLS_CERT=/etc/lingxi-next/tls/robot.crt
LINGXI_TLS_CA=/etc/lingxi-next/tls/ca.crt
LINGXI_CREDENTIALS_FILE=/var/lib/lingxi-next/credentials/ai.json
LINGXI_API_URL=https://127.0.0.1:3000
AIMDK_BRIDGE_URL=http://127.0.0.1:18082/v1
LINGXI_AGENT_URL=http://127.0.0.1:18180
LINGXI_ASR_CONFIDENCE_THRESHOLD=0.78
LINGXI_ROS_SETUP=/opt/ros/humble/setup.bash
# Set this to the existing compiled vendor workspace setup; never replace it.
LINGXI_AIMDK_SETUP=
# Physical bridge is fail-closed and disabled unless all of these are explicit.
LINGXI_INDEPENDENT_PRODUCT=0
LINGXI_NAVIGATION_SOCKET=/var/lib/lingxi-next/run/navigation.sock
LINGXI_MAP_ROOT=/var/lib/lingxi-next/maps
LINGXI_ACTIVE_MAP_ID=
LINGXI_FOOTPRINT_FILE=/etc/lingxi-next/footprint.json
LINGXI_POINTCLOUD_TOPIC=
LINGXI_LASERSCAN_TOPIC=
LINGXI_ODOMETRY_TOPIC=
LINGXI_GLOBAL_COSTMAP_TOPIC=
LINGXI_LOCAL_COSTMAP_TOPIC=
LINGXI_TERRAIN_TOPIC=
LINGXI_MAP_FRAME=lingxi_saved_map
LINGXI_BASE_FRAME=base_link
LINGXI_SENSOR_FRAME=lidar_chest_front
AIMDK_MAP_DIR=/agibot/data/var/MapManagerModule
# Optional live occupancy grid for navigation/overview, not the mapping scan view.
AIMDK_MAP_TOPIC=
# Configure either LaserScan or PointCloud2; PointCloud2 takes priority if both are set.
# Confirm actual topics/types with ros2 topic list/type/hz; never guess X2 topic names.
AIMDK_SCAN_TOPIC=
AIMDK_POINTCLOUD_TOPIC=
# AIMDK v1.1.0 state and input-source registration interfaces.
LINGXI_AIMDK_STATE_TOPIC=/aima/mc/common/state
LINGXI_AIMDK_INPUT_SOURCE_SERVICE=/aimdk_5Fmsgs/srv/SetMcInputSource
# Optional diagnostic echo only; it is never used as a stop acknowledgement.
LINGXI_AIMDK_VELOCITY_FEEDBACK_TOPIC=
# Match the target's TF tree. Missing timestamp-aligned TF shows raw sensor points,
# without accumulating them or substituting odometry from an unrelated frame.
AIMDK_LIDAR_FIXED_FRAME=map
AIMDK_BASE_FRAME=base_link
AIMDK_ODOM_TOPIC=/slam/lidar_odom
# Disabled by default. Only the explicit independent-product runtime may enable it.
# API and external ROS 2/Nav2 bridge must share a restricted UID; private dir 0700,
# socket 0600. See docs/PHYSICAL_NAVIGATION_BRIDGE.md before commissioning.
# LINGXI_NAVIGATION_SOCKET=/var/lib/lingxi-next/run/navigation.sock
ROS_DOMAIN_ID=0
# The bound intelligent-agent ID; this is distinct from Retriever Agent Code.
LINKSOUL_AGENT_ID=
# Installer appends independent generated tokens and pairing hash.

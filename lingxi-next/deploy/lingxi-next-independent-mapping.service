[Unit]
Description=Lingxi Next Independent GLIM Mapping Owner
After=network.target
Conflicts=lingxi-next-independent-slam.service
ConditionPathExists=/opt/lingxi-next/current/independent/runtime/mapping-main.mjs

[Service]
User=lingxi-next
Group=lingxi-next
EnvironmentFile=/etc/lingxi-next/robot.env
ExecStart=/bin/bash /opt/lingxi-next/current/deploy/run.sh independent-mapping
Restart=on-failure
RestartPreventExitStatus=78
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=false
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/lingxi-next
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target

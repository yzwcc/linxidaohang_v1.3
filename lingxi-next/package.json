{
  "name": "lingxi-next",
  "version": "0.1.13",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:api": "cross-env LINGXI_ENV=development LINGXI_DEMO_MODE=1 tsx watch robot-api/src/index.ts",
    "typecheck:api": "tsc -p tsconfig.api.json --noEmit",
    "build": "tsc --noEmit && npm run typecheck:api && vite build",
    "start:api": "node robot-api/dist/index.mjs",
    "build:api": "esbuild robot-api/src/index.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outfile=robot-api/dist/index.mjs",
    "build:agent": "node tools/build-agent.mjs",
    "release:commissioning": "node tools/build-release.mjs --commissioning",
    "test": "vitest run",
    "android:add": "cap add android",
    "android:sync": "npm run build && cap sync android",
    "android:build": "npm run android:sync && node tools/build-android.mjs",
    "migrate": "node tools/migrate-legacy.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.2",
    "@capacitor/core": "^7.4.2",
    "@capacitor/screen-orientation": "^7.0.4",
    "@fastify/cors": "^10.0.1",
    "@fastify/static": "^10.1.8",
    "@fastify/websocket": "^11.0.2",
    "eventsource-parser": "^4.1.3",
    "fastify": "^5.2.1",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.2",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^7.0.3",
    "esbuild": "^0.25.12",
    "fast-xml-parser": "^5.7.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.4.4",
    "vitest": "^5.0.5"
  }
}

page {
  background: #f6f7fb;
  color: #101828;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: 28rpx;
}

.page {
  padding: 24rpx;
}

.panel {
  background: #ffffff;
  border: 1rpx solid #eaecf0;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  padding: 22rpx;
}

.row {
  align-items: center;
  display: flex;
  gap: 16rpx;
  justify-content: space-between;
}

.title {
  color: #101828;
  font-size: 34rpx;
  font-weight: 700;
}

.subtitle {
  color: #667085;
  font-size: 24rpx;
  margin-top: 6rpx;
}

.status {
  border-radius: 999rpx;
  color: #ffffff;
  font-size: 22rpx;
  padding: 8rpx 16rpx;
}

.status.ok {
  background: #0f766e;
}

.status.warn {
  background: #b54708;
}

.status.bad {
  background: #b42318;
}

.btn-row {
  display: flex;
  gap: 14rpx;
  margin-top: 18rpx;
}

button {
  border-radius: 10rpx;
  font-size: 28rpx;
  line-height: 2.4;
}

.primary {
  background: #0f766e;
  color: #ffffff;
}

.secondary {
  background: #eef4ff;
  color: #175cd3;
}

.danger {
  background: #fee4e2;
  color: #b42318;
}

.warning {
  background: #fef0c7;
  color: #b54708;
}

.ghost {
  background: #f2f4f7;
  color: #344054;
}

.field {
  margin-top: 16rpx;
}

.label {
  color: #344054;
  display: block;
  font-size: 24rpx;
  margin-bottom: 8rpx;
}

input,
textarea,
picker {
  background: #ffffff;
  border: 1rpx solid #d0d5dd;
  border-radius: 10rpx;
  box-sizing: border-box;
  min-height: 76rpx;
  padding: 16rpx;
  width: 100%;
}

.list-item {
  border-top: 1rpx solid #eaecf0;
  padding: 18rpx 0;
}

.list-item:first-child {
  border-top: 0;
}

.muted {
  color: #667085;
}

.error {
  color: #b42318;
  font-size: 24rpx;
  margin-top: 10rpx;
}

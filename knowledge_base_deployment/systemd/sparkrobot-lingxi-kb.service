[Unit]
Description=SparkRobot Lingxi knowledge base retriever proxy
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=run
Group=run
WorkingDirectory=/opt/sparkrobot/lingxi-kb/current
ExecStart=/usr/bin/python3 /opt/sparkrobot/lingxi-kb/current/service/retriever_service.py --config /etc/sparkrobot/lingxi-kb/retriever.env
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/sparkrobot/lingxi-kb
UMask=0077

[Install]
WantedBy=multi-user.target

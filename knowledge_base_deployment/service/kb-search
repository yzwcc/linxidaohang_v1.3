#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import sys
import urllib.request


def main() -> int:
    parser = argparse.ArgumentParser(description="查询灵心知识库")
    parser.add_argument("query")
    parser.add_argument("--top-k", type=int, default=5)
    parser.add_argument("--url", default="http://127.0.0.1:18084/search")
    args = parser.parse_args()
    body = json.dumps({"query": args.query, "top_k": args.top_k}, ensure_ascii=False).encode()
    request = urllib.request.Request(args.url, data=body, headers={"Content-Type": "application/json"}, method="POST")
    try:
        with urllib.request.urlopen(request, timeout=30) as response:
            print(json.dumps(json.loads(response.read()), ensure_ascii=False, indent=2))
            return 0 if response.status < 300 else 1
    except Exception as exc:
        print(f"查询失败：{exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
